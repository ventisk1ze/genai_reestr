# Несекретные настройки реестра — всё необязательно. Скопируйте в registry.env и заполните нужное.
# Логины, пароли и токены сюда НЕ кладутся — start.sh спрашивает их при каждом запуске.
REG_STORAGE=json
# GP_HOST=
# GP_PORT=5432
# GP_DATABASE=
# GP_SCHEMA=
# GIGACHAT_MODEL=Qwen3.5-397b
# REG_PORT=39246
# REG_TAB_NUMBER=
# Файлы .docx и .txt в помощнике: размер файла (МБ), текст одного файла и всех файлов диалога (символов)
# REG_AI_FILE_MAX_MB=10
# REG_AI_FILE_MAX_CHARS=50000
# REG_AI_FILES_MAX_CHARS=100000
#
# Выгрузка карточек знаний в BB (Bitbucket) — новой веткой и pull request. Выгружает сам сотрудник из своего
# контейнера, через свой прокси (bash connect.sh …; владелец — bash connect.sh 127.0.0.1:39246), со своей учёткой BB.
# Логин и пароль BB сюда НЕ кладутся: connect.sh спрашивает их при каждом запуске и держит только в памяти прокси.
# Задаёт владелец сервера реестра (bash start.sh) — репозиторий базы знаний: адрес клонирования, ключ проекта
# (личный проект — ~логин), slug репозитория, ветка для pull request (по умолчанию master), папка карточек (KB):
# REG_BB_REPO_URL=https://df-bitbucket.ca.sbrf.ru/scm/kbproj/kb-cards.git
# REG_BB_PROJECT=KBPROJ
# REG_BB_REPO=kb-cards
# REG_BB_BRANCH=master
# REG_BB_DIR=KB
# Задаёт сотрудник (bash connect.sh) — свой MCP-сервер BB: путь к его server.py, python с его пакетами
# (по умолчанию python3), корпоративный Bitbucket (репозиторий принимается только с этого хоста), предел выгрузки, с.
# Путь с пробелами — в кавычках: REG_BB_MCP="/home/jovyan/bb mcp/server.py"
# REG_BB_MCP=/home/jovyan/bb-mcp/server.py
# REG_BB_MCP_PYTHON=/home/jovyan/bb-mcp/.venv/bin/python
# REG_BB_BASE_URL=https://df-bitbucket.ca.sbrf.ru
# REG_BB_TIMEOUT=600

# Базы знаний (T-012) — одна БЗ: адрес и ветка задаёт владелец сервера реестра (плейсхолдер ниже),
# путь постоянного клона — сотрудник (клонируем раз, переиспользуем; при сбое — переклонируем сами).
# REG_KB_REPO_URL=https://df-bitbucket.ca.sbrf.ru/scm/KNOWLEDGE_BASE_SVA/kb-cards.git
# REG_KB_BRANCH=master
# REG_KB_CLONE=~/kb
# REG_KB_NODE_DEPTH_MAX=8

# --local: принимать запросы только с localhost (защита от DNS-rebinding).
# Отключите (0), если --local пробрасывается через локальный прокси с чужим заголовком Host.
# REG_LOCAL_HOST_CHECK=1
